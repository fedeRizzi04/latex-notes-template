\NewEnvironmentCopy{observation}{osservazione}
\NewEnvironmentCopy{remark}{osservazione}
\NewEnvironmentCopy{corollary}{corollario}
\NewEnvironmentCopy{highlight}{evidenzia}
\NewEnvironmentCopy{algorithm}{algoritmo}

