\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{notes}[2026/09/29 Common style for lecture notes]

% =========================================================
%  DOCUMENT LANGUAGE
%  Choose it with the package option in notes.tex:
%      \usepackage[italiano]{notes}   or   \usepackage[english]{notes}
%  All labels (Definizione/Definition, Teorema/Theorem, etc.) and
%  babel's language adapt automatically.
% =========================================================
\newcommand{\dispensalingua}{english}
\DeclareOption{italiano}{\renewcommand{\dispensalingua}{italiano}}
\DeclareOption{english}{\renewcommand{\dispensalingua}{english}}
\ProcessOptions\relax

% ---------- Fonts and encoding ----------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{patterns, calc}


\ifdefstring{\dispensalingua}{italiano}{%
    \RequirePackage[italian]{babel}
}{%
    \RequirePackage[english]{babel}
}

\RequirePackage[semibold]{libertinus} % same font family for text, math and monospace
\RequirePackage{scrhack}              % titlesec/tocloft compatibility with KOMA

% ---------- Layout ----------
\RequirePackage[a4paper,margin=2.7cm]{geometry}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{titling}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage{titlesec}
\RequirePackage{titletoc}

% ---------- Paragraphs: no indent, one blank line between paragraphs ----------
\setlength{\parskip}{\baselineskip}
\setlength{\parindent}{0pt}
% ---------- Section titles ----------
% section, subsection, subsubsection, paragraph: all numbered and in the TOC
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}

% Structure: Part > Section > Subsection > ... (no chapters), so sections
% are numbered 1, 2, 3 without the chapter prefix.
\renewcommand{\thesection}{\arabic{section}}

\titleformat{\part}[display]
  {\normalfont\bfseries\centering}
  {\Large\thepart}
  {1ex}
  {\huge}
\titlespacing*{\part}{0pt}{2cm}{3cm}

\titleformat{\section}
  {\normalfont\Large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}{\thesubsubsection}{1em}{}
\titleformat{\paragraph}[block]
  {\normalfont\normalsize\bfseries}{\theparagraph}{1em}{}
\titlespacing*{\paragraph}{0pt}{2.3ex plus 1ex minus .2ex}{1em}

