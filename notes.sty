\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,listings}

% ---------- Code / pseudocode ----------
\RequirePackage{listings}

% Pseudocode style: text between $...$ is typeset as math, e.g.
%   while $i \neq 0$ do
%       a $\gets$ 5
\lstdefinestyle{pseudo}{
    basicstyle=\ttfamily\small,
    mathescape=true,
    escapechar=\%,                 % use %...% for italic comments, e.g. %this is a comment%
    tabsize=2,
    columns=fullflexible,
    keepspaces=true,
    showstringspaces=false,
    breaklines=true,
    breakindent=1.5em,
    numbers=left,
    numberstyle=\tiny\color{secondario},
    numbersep=10pt,
    xleftmargin=1.8em,
    keywordstyle=\bfseries,         % bold, no color
    commentstyle=\itshape\color{secondario},
    % keywords recognized automatically (Italian + English)
    keywords={%
        while,do,end,if,then,else,for,to,downto,repeat,until,%
        return,function,procedure,begin,and,or,not,in,break,continue,%
        mentre,fare,fine,se,allora,altrimenti,per,ripeti,finche,%
        restituisci,funzione,procedura,inizio,e,o,non%
    },
}
\lstset{style=pseudo}

% "algoritmo" environment: no background or frame, just a rule above and
% one below. Usage:
%
%   \begin{algoritmo}{Algorithm title}
%   procedure Example(n)
%       i $\gets$ 0
%       while $i \neq n$ do
%           i $\gets$ i + 1
%       return i
%   \end{algoritmo}
%
\NewTCBListing{algoritmo}{O{} g}{%
    enhanced,
    breakable,
    listing only,
    listing options={style=pseudo},
    colback=white,          % no background
    colbacktitle=white,     % title on white background
    colframe=black,
    coltitle=black,
    fonttitle=\bfseries,
    boxrule=0pt,             % no border
    leftrule=0pt,rightrule=0pt,
    toprule=0.9pt,           % thin rule above (below the caption)
    bottomrule=0.4pt,        % thin rule below the code
    arc=0pt,
    left=0pt,right=0pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtalgoritmo~\thetcbcounter}{#2}},
    #1
}

% ---------- Nested boxes that break across pages ----------
% tcolorbox only breaks the outermost box across pages: a box inside another
% one (e.g. a lemma inside the proof of a theorem) becomes a single block
% and, if it does not fit, jumps to the next page leaving a gap. That is why
% the colored environments are defined with \NewBreakableBox (same syntax
% as \NewTColorBox): on their own they are plain tcolorboxes, when nested
% the content is cut line by line and each line becomes a "strip" of the box
% (the first one with the title, the last one with the bottom border). The
% strips touch each other so the box looks whole, but the outer box can
% break the page between two strips.
\newbox\nb@content
\newbox\nb@piece
\newbox\nb@strip
\newdimen\nb@total      % height of the content
\newdimen\nb@top        % top of the current line (from the top)
\newdimen\nb@cut        % cut above the current line
\newdimen\nb@nexttop
\newdimen\nb@nextcut
\newcount\nb@n
\newif\ifnb@last

\newcommand{\NewBreakableBox}[3]{%
    \NewDocumentEnvironment{#1}{#2}
        {\begin{breakablebox}{#3}}
        {\end{breakablebox}}%
}

\NewDocumentEnvironment{breakablebox}{+m}{%
    \ifnum\c@tcblayer>\z@
        \expandafter\@firstoftwo
    \else
        \expandafter\@secondoftwo
    \fi
    {\let\nb@end\nb@close\nb@open{#1}}%
    {\def\nb@end{\end{tcolorbox}}\begin{tcolorbox}[#1]}%
}{\nb@end}

% Typesets the content as tcolorbox would, but in a \vbox we can cut.
\newcommand{\nb@open}[1]{%
    \def\nb@options{#1}%
    \tcbset{reset,every box,#1}%
    \let\iftcb@minipage\if@minipage
    \tcbdimto\nb@width{\kvtcb@width-(\kvtcb@left@rule+\kvtcb@leftupper
        +(\kvtcb@boxsep)*2+\kvtcb@rightupper+\kvtcb@right@rule)}%
    \setbox\nb@content\vbox\bgroup
        \hsize=\nb@width
        \color@begingroup
        \textwidth\hsize \columnwidth\hsize
        \@parboxrestore
        \let\@listdepth\@mplistdepth \@mplistdepth\z@
        \@setminipage
        \color{tcbcolupper}%
        \kvtcb@fontupper\kvtcb@halignupper\tcb@insert@before@upper
}
\newcommand{\nb@close}{%
        \par\unskip\@minipagefalse
        \color@endgroup
    \egroup
    \kvtcb@beforebox
    \begingroup
    \vbadness\@M \vfuzz\maxdimen \boxmaxdepth\maxdimen
    \splittopskip\z@skip \splitmaxdepth\maxdimen \parskip\z@skip
    \nb@total=\dimexpr\ht\nb@content+\dp\nb@content\relax
    \nb@top\z@ \nb@cut\z@ \nb@n\z@
    \nb@loop
    \endgroup
    \kvtcb@afterbox
}

% Takes one line at a time (\vsplit to 0pt stops at the first possible
% break) and cuts halfway through the space between two lines.
\def\nb@loop{%
    \ifvoid\nb@content\else
        \advance\nb@n\@ne
        \setbox\nb@piece\vsplit\nb@content to \z@
        \setbox\nb@piece\vbox{\unvbox\nb@piece}%
        \nb@lastfalse
        \ifvoid\nb@content
            \nb@lasttrue
        \else
            \ifdim\dimexpr\ht\nb@content+\dp\nb@content\relax=\z@
                \setbox\nb@piece\vbox{\unvbox\nb@piece\unvbox\nb@content}%
                \nb@lasttrue
            \fi
        \fi
        \ifnb@last
            \nb@nexttop\nb@total \nb@nextcut\nb@total
        \else
            \nb@nexttop=\dimexpr\nb@total-\ht\nb@content-\dp\nb@content\relax
            \nb@nextcut=\dimexpr(\nb@top+\ht\nb@piece+\dp\nb@piece
                +\nb@nexttop)/2\relax
        \fi
        \nb@emit
        \nb@top\nb@nexttop \nb@cut\nb@nextcut
        \expandafter\nb@loop
    \fi
}

\def\nb@emit{%
    \edef\nb@height{\the\dimexpr\nb@nextcut-\nb@cut\relax}%
    \edef\nb@offset{\the\dimexpr\nb@top-\nb@cut\relax}%
    \edef\nb@kind{%
        \ifnum\nb@n=\@ne \ifnb@last whole\else first\fi
        \else \ifnb@last last\else middle\fi\fi}%
    \setbox\nb@strip\hbox{%
        \expandafter\nb@box\expandafter{\nb@options}%
            {\vbox to \nb@height{\vskip\nb@offset\box\nb@piece\vss}}%
    }%
    \ifnum\nb@n>\@ne
        \penalty\ifnb@last\widowpenalty\else
            \ifnum\nb@n=\tw@\clubpenalty\else\interlinepenalty\fi\fi
        \nointerlineskip\noindent
    \fi
    \box\nb@strip\par
}
\long\def\nb@box#1#2{%
    \begin{tcolorbox}[#1,nobeforeafter,before upper=,after upper=,nb/\nb@kind]#2\end{tcolorbox}%
}

% The strips after the first slightly overlap the previous one, so that no
% thin lines show up between them in PDF viewers.
\tcbset{
    nb/whole/.style={},
    nb/first/.style={skin=enhancedfirst,bottomrule=0pt,bottom=-\kvtcb@boxsep},
    nb/middle/.style={skin=enhancedmiddle,notitle,toprule=0pt,bottomrule=0pt,
        top=-\kvtcb@boxsep,bottom=-\kvtcb@boxsep,nb/overlap},
    nb/last/.style={skin=enhancedlast,notitle,toprule=0pt,
        top=-\kvtcb@boxsep,nb/overlap},
    nb/overlap/.style={underlay={%
        \fill[tcbcolframe] (frame.north west) rectangle ([yshift=.3pt]frame.north east);
        \fill[tcbcolback] ([yshift=-.3pt]interior.north west) rectangle ([yshift=.6pt]interior.north east);
    }},
}

% ---------- Colored math environments ----------
\NewBreakableBox{definizione}{O{} g}{%
    enhanced,breakable,
    colback=defbg,colframe=defframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtdefinizione}{#2}},#1
}

% Property: the title sits on the top border of the box.
\NewBreakableBox{proprieta}{O{} g}{%
    enhanced,breakable,
    colback=propbg,colframe=propframe,coltitle=propframe,fonttitle=\bfseries,
    boxrule=0.8pt,arc=2mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
    attach boxed title to top left={xshift=2mm,yshift=-\tcboxedtitleheight/2},
    boxed title style={colback=propbg,colframe=propframe,boxrule=0pt,arc=0pt,left=1mm,right=1mm},
    before skip=10pt,after skip=10pt,
    title={\titoloambiente{\txtproprieta}{#2}},#1
}

\NewBreakableBox{teorema}{O{} g}{%
    enhanced,breakable,
    colback=thbg,colframe=thframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{thframe}%
    },
    title={\titoloambiente{\txtteorema}{#2}},#1
}

\NewBreakableBox{lemma}{O{} g}{%
    enhanced,breakable,
    colback=lembg,colframe=lemframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{lemframe}%
    },
    title={\titoloambiente{\txtlemma}{#2}},
    #1
}

\NewBreakableBox{esempio}{O{} g}{%
    enhanced,breakable,
    colback=exbg,colframe=exframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtesempio}{#2}},#1
}

\NewBreakableBox{nota}{O{} g}{%
    enhanced,
    breakable,
    colback=white,
    colframe=secondario,
    coltitle=white,
    fonttitle=\bfseries,
    boxrule=0.4pt,
    arc=1mm,
    left=6pt,
    right=6pt,
    top=2pt,
    bottom=2pt,
    title={\titoloambiente{\txtnota}{#2}},
    #1
}

% Observation: cream background; title bar and frame take the color of the
% enclosing box (theorem, lemma, corollary), green outside other boxes.
\NewBreakableBox{osservazione}{O{} g}{%
    enhanced,
    breakable,
    colback=obsbg,colframe=\obsContextFrame,
    colbacktitle=\obsContextFrame,
    coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,
    arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={%
        \IfNoValueTF{#2}
            {\txtosservazione}%
            {\ifstrempty{#2}{\txtosservazione}{\txtosservazione{}~#2}}%
    },
    #1
}

% Corollary: meant to go right after a theorem. Same red as the theorem,
% with a lighter background, no title bar and a thicker rule on the left.
\NewBreakableBox{corollario}{O{} g}{%
    enhanced,breakable,
    colback=corbg,colframe=thframe,colbacktitle=corbg,coltitle=thframe,fonttitle=\bfseries,
    boxrule=0.5pt,leftrule=2.5pt,titlerule=0.3pt,
    arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{thframe}%
    },
    title={\titoloambiente{\txtcorollario}{#2}},#1
}

% ---------- "evidenzia" block ----------
% Vertical bar on the left and a lightly tinted background, no frame: makes a
% block of text stand out (e.g. the definition of a problem) without looking
% like a box. It is defined like the other boxes, so it also breaks across
% pages inside another box (a theorem, a proof inside a theorem, ...).
% Optional title:
%
%   \begin{evidenzia}           ...  \end{evidenzia}
%   \begin{evidenzia}[Title]    ...  \end{evidenzia}
%
\definecolor{evidbg}{RGB}{242,244,247}      % very light blue-gray
\definecolor{evidbar}{RGB}{20,60,110}       % primary blue
\NewBreakableBox{evidenzia}{O{}}{%
    enhanced,breakable,
    colback=evidbg,colframe=evidbar,frame hidden,
    boxrule=0pt,leftrule=2.5pt,borderline west={2.5pt}{0pt}{evidbar},
    sharp corners,
    boxsep=0pt,left=7pt,right=7pt,top=7pt,bottom=7pt,
    before upper={%
        \setlength{\parskip}{0.5\baselineskip}%
        \setlist{topsep=0pt,partopsep=0pt}%
        \ifstrempty{#1}{}{\noindent\textbf{\textcolor{evidbar}{#1}}\par}%
    },
}

% ---------- Proof: light section with visible start and end ----------
\renewcommand{\qedsymbol}{$\blacksquare$}
\makeatletter
\renewenvironment{proof}[1][\txtdimostrazione]{\par\vspace{-0.35\baselineskip}
    \pushQED{\qed}%
    \normalfont \topsep2\p@\@plus2\p@\relax
    \noindent\textcolor{secondario}{\rule{\linewidth}{0.4pt}}\par
    \trivlist
    \item[\hskip\labelsep\bfseries #1\@addpunct{.}]\ignorespaces
}{%
    \popQED\endtrivlist\@endpefalse
    \par\vspace{1pt}\noindent\textcolor{secondario}{\rule{\linewidth}{0.4pt}}\par
}
\makeatother

