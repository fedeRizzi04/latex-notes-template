% Optional title shared by the colored environments: without the braces
% only the environment label is shown.
\newcommand{\titoloambiente}[2]{%
    \IfNoValueTF{#2}
        {#1}%
        {\ifstrempty{#2}{#1}{#1{} --- #2}}%
}

% ---------- Table of contents: spacing, bold, dots ----------
% Part: \thepart already includes the label ("Parte I" / "Part I");
% in the TOC it uses KOMA's default style (bold, no dots).
\renewcommand{\thepart}{\txtparte~\Roman{part}}

% Section: bold, dots, space before each entry
\titlecontents{section}
  [0pt]
  {\addvspace{11pt}\bfseries}
  {\thecontentslabel.\ }
  {}
  {\bfseries\titlerule*[0.6pc]{.}\contentspage}

% Subsection
\titlecontents{subsection}
  [1.6em]
  {\normalfont}
  {\thecontentslabel.\ }
  {}
  {\normalfont\titlerule*[0.5pc]{.}\contentspage}

% Subsubsection
\titlecontents{subsubsection}
  [3.4em]
  {\normalfont\small}
  {\thecontentslabel.\ }
  {}
  {\normalfont\small\titlerule*[0.5pc]{.}\contentspage}

% Paragraph
\titlecontents{paragraph}
  [5.2em]
  {\normalfont\small}
  {\thecontentslabel.\ }
  {}
  {\normalfont\small\titlerule*[0.5pc]{.}\contentspage}

% ---------- Math ----------
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}

% ---------- Colored boxes (definitions, theorems, examples, algorithms) ----------
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,listings}

% ---------- Code / pseudocode ----------
\RequirePackage{listings}

% Pseudocode style: text between $...$ is typeset as math, e.g.
%   while $i \neq 0$ do
%       a $\gets$ 5
\lstdefinestyle{pseudo}{
    basicstyle=\ttfamily\small,
    mathescape=true,
    escapechar=\%,                 % use %...% for italic comments, e.g. %this is a comment%
    tabsize=2,
    columns=fullflexible,
    keepspaces=true,
    showstringspaces=false,
    breaklines=true,
    breakindent=1.5em,
    numbers=left,
    numberstyle=\tiny\color{secondario},
    numbersep=10pt,
    xleftmargin=1.8em,
    keywordstyle=\bfseries,         % bold, no color
    commentstyle=\itshape\color{secondario},
    % keywords recognized automatically (Italian + English)
    keywords={%
        while,do,end,if,then,else,for,to,downto,repeat,until,%
        return,function,procedure,begin,and,or,not,in,break,continue,%
        mentre,fare,fine,se,allora,altrimenti,per,ripeti,finche,%
        restituisci,funzione,procedura,inizio,e,o,non%
    },
}
\lstset{style=pseudo}

% "algoritmo" environment: no background or frame, just a rule above and
% one below. Usage:
%
%   \begin{algoritmo}{Algorithm title}
%   procedure Example(n)
%       i $\gets$ 0
%       while $i \neq n$ do
%           i $\gets$ i + 1
%       return i
%   \end{algoritmo}
%
\NewTCBListing{algoritmo}{O{} g}{%
    enhanced,
    breakable,
    listing only,
    listing options={style=pseudo},
    colback=white,          % no background
    colbacktitle=white,     % title on white background
    colframe=black,
    coltitle=black,
    fonttitle=\bfseries,
    boxrule=0pt,             % no border
    leftrule=0pt,rightrule=0pt,
    toprule=0.9pt,           % thin rule above (below the caption)
    bottomrule=0.4pt,        % thin rule below the code
    arc=0pt,
    left=0pt,right=0pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtalgoritmo~\thetcbcounter}{#2}},
    #1
}

% ---------- Colored math environments ----------
\NewTColorBox{definizione}{O{} g}{%
    enhanced,breakable,
    colback=defbg,colframe=defframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtdefinizione}{#2}},#1
}

% Property: the title sits on the top border of the box.
\NewTColorBox{proprieta}{O{} g}{%
    enhanced,breakable,
    colback=propbg,colframe=propframe,coltitle=propframe,fonttitle=\bfseries,
    boxrule=0.8pt,arc=2mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
    attach boxed title to top left={xshift=2mm,yshift=-\tcboxedtitleheight/2},
    boxed title style={colback=propbg,colframe=propframe,boxrule=0pt,arc=0pt,left=1mm,right=1mm},
    before skip=10pt,after skip=10pt,
    title={\titoloambiente{\txtproprieta}{#2}},#1
}

\NewTColorBox{teorema}{O{} g}{%
    enhanced,breakable,
    colback=thbg,colframe=thframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{thframe}%
    },
    title={\titoloambiente{\txtteorema}{#2}},#1
}

\NewTColorBox{lemma}{O{} g}{%
    enhanced,breakable,
    colback=lembg,colframe=lemframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{lemframe}%
    },
    title={\titoloambiente{\txtlemma}{#2}},
    #1
}

\NewTColorBox{esempio}{O{} g}{%
    enhanced,breakable,
    colback=exbg,colframe=exframe,coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={\titoloambiente{\txtesempio}{#2}},#1
}

\NewTColorBox{nota}{O{} g}{%
    enhanced,
    breakable,
    colback=white,
    colframe=secondario,
    coltitle=white,
    fonttitle=\bfseries,
    boxrule=0.4pt,
    arc=1mm,
    left=6pt,
    right=6pt,
    top=2pt,
    bottom=2pt,
    title={\titoloambiente{\txtnota}{#2}},
    #1
}

% Observation: cream background; title bar and frame take the color of the
% enclosing box (theorem, lemma, corollary), green outside other boxes.
\NewTColorBox{osservazione}{O{} g}{%
    enhanced,
    breakable,
    colback=obsbg,colframe=\obsContextFrame,
    colbacktitle=\obsContextFrame,
    coltitle=white,fonttitle=\bfseries,
    boxrule=0.5pt,
    arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    title={%
        \IfNoValueTF{#2}
            {\txtosservazione}%
            {\ifstrempty{#2}{\txtosservazione}{\txtosservazione{}~#2}}%
    },
    #1
}

% Corollary: meant to go right after a theorem. Same red as the theorem,
% with a lighter background, no title bar and a thicker rule on the left.
\NewTColorBox{corollario}{O{} g}{%
    enhanced,breakable,
    colback=corbg,colframe=thframe,colbacktitle=corbg,coltitle=thframe,fonttitle=\bfseries,
    boxrule=0.5pt,leftrule=2.5pt,titlerule=0.3pt,
    arc=1mm,left=6pt,right=6pt,top=3pt,bottom=3pt,
    before upper={%
        \renewcommand{\obsContextFrame}{thframe}%
    },
    title={\titoloambiente{\txtcorollario}{#2}},#1
}

% ---------- "evidenzia" block ----------
% Vertical bar on the left and a lightly tinted background, no frame: makes a
% block of text stand out (e.g. the definition of a problem) without using a
% box. Breaks across pages, also inside another box (a theorem, a proof
% inside a theorem, ...). Optional title:
%
%   \begin{evidenzia}           ...  \end{evidenzia}
%   \begin{evidenzia}[Title]    ...  \end{evidenzia}
%
% In normal text framed does the job. Inside another box framed cannot
% break, so the content is cut line by line and each piece is colored on
% its own: the outer box can then break the page between two lines.
\RequirePackage{framed}
\definecolor{evidbg}{RGB}{242,244,247}      % very light blue-gray
\definecolor{evidbar}{RGB}{20,60,110}       % primary blue
\newcommand{\evid@barw}{2.5pt}              % bar thickness
\newcommand{\evid@pad}{7pt}                 % inner padding
\newsavebox{\evid@content}
\newsavebox{\evid@piece}
\newsavebox{\evid@cur}
\newdimen\evid@wd
\newif\ifevid@has
\newif\ifevid@first
\newenvironment{evidenzia}[1][]{%
    \par
    \ifinner
        \let\evid@end\evid@endinner
        \setbox\evid@content\vbox\bgroup
            \advance\hsize-\dimexpr\evid@barw+2\dimexpr\evid@pad\relax\relax
            \FrameRestore
    \else
        \let\evid@end\endMakeFramed
        \def\FrameCommand{%
            {\color{evidbar}\vrule width \evid@barw}%
            \fboxsep=\evid@pad\colorbox{evidbg}%
        }%
        \MakeFramed{\advance\hsize-\width \FrameRestore}%
    \fi
    \setlength{\parskip}{0.5\baselineskip}%
    \setlist{topsep=0pt,partopsep=0pt}%
    \ifstrempty{#1}{}{\noindent\textbf{\textcolor{evidbar}{#1}}\par}%
}{%
    \evid@end
}
% Puts the piece in \evid@cur on the page with bar and background; #1 = how
% far the background goes past the bottom (avoids thin white lines between
% pieces in some PDF viewers).
\newcommand{\evid@emit}[1]{%
    \setbox\evid@cur\vbox{\unvbox\evid@cur\kern\z@}%
    \ifevid@first\evid@firstfalse\else\nointerlineskip\fi
    \hbox{%
        {\color{evidbar}\vrule width \evid@barw height \ht\evid@cur depth #1}%
        {\color{evidbg}\vrule width \dimexpr\evid@wd+2\dimexpr\evid@pad\relax\relax
            height \ht\evid@cur depth #1}%
        \kern-\dimexpr\evid@wd+\evid@pad\relax
        \hbox to\evid@wd{\box\evid@cur\hss}%
        \kern\evid@pad
    }%
    \kern-#1\relax
}
\newcommand{\evid@endinner}{%
    \par\egroup
    \evid@wd\wd\evid@content
    \splittopskip\z@ \splitmaxdepth\maxdimen
    \vfuzz\maxdimen \vbadness\@M % no warnings for the \vsplit to height 0
    \setbox\evid@cur\vbox{\kern\evid@pad}%
    \evid@hasfalse \evid@firsttrue
    \loop\unless\ifvoid\evid@content
        % \vsplit to height 0 takes a single line; the space dropped at the
        % cut (\dimen@) is put back by hand below the line
        \dimen@\dimexpr\ht\evid@content+\dp\evid@content\relax
        \setbox\evid@piece\vsplit\evid@content to \z@
        \setbox\evid@piece\vbox{\unvbox\evid@piece}%
        \advance\dimen@-\dimexpr\ht\evid@piece+\dp\evid@piece\relax
        \ifvoid\evid@content\else
            \advance\dimen@-\dimexpr\ht\evid@content+\dp\evid@content\relax
        \fi
        \ifevid@has
            \ifdim\dimexpr\ht\evid@piece+\dp\evid@piece\relax>\z@
                \evid@emit{0.5pt}\penalty\z@
                \setbox\evid@cur\vbox{}%
            \fi
        \fi
        \setbox\evid@cur\vbox{\unvbox\evid@cur\box\evid@piece\kern\dimen@}%
        \evid@hastrue
    \repeat
    \setbox\evid@cur\vbox{\unvbox\evid@cur\kern\evid@pad}%
    \evid@emit{\z@}%
}

% ---------- Proof: light section with visible start and end ----------
\renewcommand{\qedsymbol}{$\blacksquare$}
\makeatletter
\renewenvironment{proof}[1][\txtdimostrazione]{\par\vspace{-0.35\baselineskip}
    \pushQED{\qed}%
    \normalfont \topsep2\p@\@plus2\p@\relax
    \noindent\textcolor{secondario}{\rule{\linewidth}{0.4pt}}\par
    \trivlist
    \item[\hskip\labelsep\bfseries #1\@addpunct{.}]\ignorespaces
}{%
    \popQED\endtrivlist\@endpefalse
    \par\vspace{1pt}\noindent\textcolor{secondario}{\rule{\linewidth}{0.4pt}}\par
}
\makeatother

