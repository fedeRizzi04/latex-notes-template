% Optional title shared by the colored environments: without the braces
% only the environment label is shown.
\newcommand{\titoloambiente}[2]{%
    \IfNoValueTF{#2}
        {#1}%
        {\ifstrempty{#2}{#1}{#1{} --- #2}}%
}

% ---------- Table of contents: spacing, bold, dots ----------
% Part: \thepart already includes the label ("Parte I" / "Part I");
% in the TOC it uses KOMA's default style (bold, no dots).
\renewcommand{\thepart}{\txtparte~\Roman{part}}

% Section: bold, dots, space before each entry
\titlecontents{section}
  [0pt]
  {\addvspace{11pt}\bfseries}
  {\thecontentslabel.\ }
  {}
  {\bfseries\titlerule*[0.6pc]{.}\contentspage}

% Subsection
\titlecontents{subsection}
  [1.6em]
  {\normalfont}
  {\thecontentslabel.\ }
  {}
  {\normalfont\titlerule*[0.5pc]{.}\contentspage}

% Subsubsection
\titlecontents{subsubsection}
  [3.4em]
  {\normalfont\small}
  {\thecontentslabel.\ }
  {}
  {\normalfont\small\titlerule*[0.5pc]{.}\contentspage}

% Paragraph
\titlecontents{paragraph}
  [5.2em]
  {\normalfont\small}
  {\thecontentslabel.\ }
  {}
  {\normalfont\small\titlerule*[0.5pc]{.}\contentspage}

% ---------- Math ----------
\RequirePackage{amsmath,amssymb,amsthm}
